# Démonstration sur un vrai téléphone (même Wi-Fi que l'ordinateur) : l'application
# parle aux émulateurs Firebase de l'ordinateur, dont l'adresse est détectée
# automatiquement (aucun vrai projet Firebase, valeurs fictives "demo-").
EXPO_PUBLIC_USE_FIREBASE_EMULATOR=true
EXPO_PUBLIC_FIREBASE_API_KEY=demo-api-key
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=demo-mesbonnesadresses.firebaseapp.com
EXPO_PUBLIC_FIREBASE_PROJECT_ID=demo-mesbonnesadresses
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=demo-mesbonnesadresses.appspot.com
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=000000000000
EXPO_PUBLIC_FIREBASE_APP_ID=1:000000000000:web:0000000000000000
