# Copier ce fichier en `.env.local` puis renseigner les valeurs de votre projet Firebase
# (Console Firebase > Paramètres du projet > Vos applications > Application Web).
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=

# Utiliser les émulateurs Firebase locaux (tests e2e / développement hors ligne).
# Hôte : "localhost" pour le simulateur iOS, "10.0.2.2" pour l'émulateur Android.
EXPO_PUBLIC_USE_FIREBASE_EMULATOR=false
EXPO_PUBLIC_FIREBASE_EMULATOR_HOST=localhost

# Clé Google Maps (uniquement pour les builds Android natifs, inutile avec Expo Go).
GOOGLE_MAPS_API_KEY=
