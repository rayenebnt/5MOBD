{
  "name": "mes-bonnes-adresses",
  "version": "1.0.0",
  "main": "index.ts",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "demo:prepare": "firebase emulators:start --project demo-mesbonnesadresses --import=./emulator-data --export-on-exit",
    "demo:firebase": "firebase emulators:start --project demo-mesbonnesadresses --import=./emulator-data",
    "demo:save": "firebase emulators:export ./emulator-data --project demo-mesbonnesadresses --force",
    "demo:android": "node --env-file=.env.e2e node_modules/expo/bin/cli start --android --clear",
    "demo:phone": "node --env-file=.env.demo node_modules/expo/bin/cli start --clear",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:firebase": "firebase emulators:exec --only auth,firestore,storage --project demo-mesbonnesadresses \"jest -c jest.firebase.config.js\"",
    "emulators": "firebase emulators:start --project demo-mesbonnesadresses",
    "start:e2e": "node --env-file=.env.e2e node_modules/expo/bin/cli start --android --clear",
    "e2e": "maestro test .maestro -e APP_ID=host.exp.exponent -e EXPO_URL=exp://127.0.0.1:8081",
    "e2e:build:android": "node --env-file=.env.e2e node_modules/expo/bin/cli run:android",
    "e2e:native": "maestro test .maestro -e APP_ID=com.mesbonnesadresses.app",
    "start:storybook": "cross-env EXPO_PUBLIC_STORYBOOK_ENABLED=true expo start --clear",
    "storybook:generate": "sb-rn-get-stories --config-path .rnstorybook",
    "deploy:rules": "firebase deploy --only firestore:rules,storage"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/datetimepicker": "9.2.1",
    "@react-native-community/slider": "5.2.1",
    "expo": "~58.0.23",
    "expo-asset": "~58.0.20",
    "expo-constants": "~58.0.15",
    "expo-font": "~58.0.11",
    "expo-image-picker": "~58.0.10",
    "expo-linking": "~58.0.16",
    "expo-location": "~58.0.20",
    "expo-router": "~58.0.30",
    "expo-status-bar": "~58.0.4",
    "firebase": "^12.19.0",
    "react": "19.3.0",
    "react-native": "0.88.1",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-maps": "1.29.11",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-screens": "~4.30.1",
    "react-native-svg": "15.16.0",
    "react-native-worklets": "0.13.0"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@firebase/rules-unit-testing": "^5.0.2",
    "@gorhom/bottom-sheet": "^5.2.14",
    "@storybook/addon-ondevice-actions": "^9.1.4",
    "@storybook/addon-ondevice-controls": "^9.1.4",
    "@storybook/react": "^9.1.20",
    "@storybook/react-native": "^9.1.4",
    "@testing-library/react-native": "^14.1.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.13.0",
    "@types/react": "~19.3.0",
    "babel-preset-expo": "~58.0.24",
    "cross-env": "^7.0.3",
    "firebase-tools": "^15.33.0",
    "jest": "^30.0.0",
    "jest-expo": "~58.0.14",
    "react-dom": "19.3.0",
    "storybook": "^9.1.20",
    "typescript": "~6.0.3",
    "test-renderer": "1.3.0"
  }
}
