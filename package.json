{
  "name": "mes-bonnes-adresses",
  "version": "1.0.0",
  "main": "index.ts",
  "private": true,
  "engines": {
    "node": ">=20.18.0"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "demo:firebase": "firebase emulators:start --project demo-mesbonnesadresses --import=./emulator-data --export-on-exit",
    "demo:save": "firebase emulators:export ./emulator-data --project demo-mesbonnesadresses --force",
    "demo:android": "node --env-file=.env.e2e node_modules/expo/bin/cli start --android --clear",
    "demo:phone": "node --env-file=.env.demo node_modules/expo/bin/cli start --clear",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:firebase": "firebase emulators:exec --only auth,firestore,storage --project demo-mesbonnesadresses \"jest -c jest.firebase.config.js\"",
    "emulators": "firebase emulators:start --project demo-mesbonnesadresses",
    "start:e2e": "node --env-file=.env.e2e node_modules/expo/bin/cli start --android --clear",
    "e2e": "maestro test .maestro -e APP_ID=host.exp.exponent -e EXPO_URL=exp://127.0.0.1:8081",
    "e2e:build:android": "node --env-file=.env.e2e node_modules/expo/bin/cli run:android",
    "e2e:native": "maestro test .maestro -e APP_ID=com.mesbonnesadresses.app",
    "start:storybook": "cross-env EXPO_PUBLIC_STORYBOOK_ENABLED=true expo start --clear",
    "storybook:generate": "sb-rn-get-stories --config-path .rnstorybook",
    "deploy:rules": "firebase deploy --only firestore:rules,storage"
  },
  "dependencies": {
    "@expo/vector-icons": "^14.1.0",
    "@react-native-async-storage/async-storage": "2.1.2",
    "@react-native-community/datetimepicker": "8.4.1",
    "@react-native-community/slider": "4.5.6",
    "expo": "~53.0.27",
    "expo-asset": "~11.1.7",
    "expo-constants": "~17.1.8",
    "expo-font": "~13.3.2",
    "expo-image-picker": "~16.1.4",
    "expo-linking": "~7.1.7",
    "expo-location": "~18.1.6",
    "expo-router": "~5.1.11",
    "expo-status-bar": "~2.2.3",
    "firebase": "^12.19.0",
    "react": "19.0.0",
    "react-native": "0.79.6",
    "react-native-gesture-handler": "~2.24.0",
    "react-native-maps": "1.20.1",
    "react-native-reanimated": "~3.17.4",
    "react-native-safe-area-context": "5.4.0",
    "react-native-screens": "~4.11.1",
    "react-native-svg": "15.11.2"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@firebase/rules-unit-testing": "^5.0.2",
    "@gorhom/bottom-sheet": "^5.2.14",
    "@storybook/addon-ondevice-actions": "^9.1.4",
    "@storybook/addon-ondevice-controls": "^9.1.4",
    "@storybook/react": "^9.1.20",
    "@storybook/react-native": "^9.1.4",
    "@testing-library/react-native": "^13.3.3",
    "@types/jest": "^29.5.14",
    "@types/react": "~19.0.10",
    "cross-env": "^7.0.3",
    "firebase-tools": "^15.33.0",
    "jest": "~29.7.0",
    "jest-expo": "~53.0.14",
    "react-dom": "^19.0.0",
    "react-test-renderer": "^19.0.0",
    "storybook": "^9.1.20",
    "typescript": "~5.8.3"
  },
  "overrides": {
    "@react-navigation/native": "7.1.17",
    "@react-navigation/core": "7.12.4",
    "@react-navigation/elements": "2.6.4",
    "@react-navigation/bottom-tabs": "7.4.7",
    "@react-navigation/native-stack": "7.3.26",
    "@react-navigation/routers": "7.5.1"
  }
}
